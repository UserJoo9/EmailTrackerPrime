{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/track/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/pixel/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.js"
    }
  ]
}
