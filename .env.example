PORT=3000

# مفتاح الـ API: لازم يتضبط في الإنتاج (Vercel > Settings > Environment Variables).
# مثال لتوليده:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Upstash Redis (بيتضبطوا تلقائياً لما تربط قاعدة البيانات في Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
